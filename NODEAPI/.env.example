# MongoDB Configuration
# Get your connection string from MongoDB Atlas
# If you do not have Atlas, use a local MongoDB instance:
MONGO_URL=mongodb+srv://your-username:your-password@your-cluster.mongodb.net/database-name?retryWrites=true&w=majority&appName=YourAppName

# Server Configuration
PORT=3000
NODE_ENV=development

# Frontend Configuration (CORS)
# Update this to match your frontend URL in different environments
FRONTEND_URL=http://localhost:5173

# API Configuration
API_VERSION=v2

# Sign-in (Microsoft Entra External ID, ADR-014)
# Every /api/v2/ request needs a valid access token for this API; without these four the API answers 500.
# Find them in the Entra admin center: the issuer and the keys address under the tenant's OpenID configuration,
# the audience (the API's application/client ID) and the scope name under the API app registration's "Expose an API".
ENTRA_ISSUER=https://<tenant-id>.ciamlogin.com/<tenant-id>/v2.0
ENTRA_JWKS_URI=https://<tenant-subdomain>.ciamlogin.com/<tenant-id>/discovery/v2.0/keys
ENTRA_API_AUDIENCE=<api-client-id>
ENTRA_API_SCOPE=<scope-name>
# No Entra tenant yet? `npm run dev:auth` serves a throwaway key on 127.0.0.1 and prints values for these four lines
# (and a token for the frontend). Dev only; see "Sign-in setup" in Docs/README.md.

