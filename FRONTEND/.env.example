# Frontend configuration. Copy to .env.local (or .env) and fill in. Only VITE_ variables reach the browser,
# so nothing secret belongs here: the frontend holds no client secret.

# The API's address (default http://localhost:3000)
VITE_API_BASE_URL=http://localhost:3000

# Sign-in (Microsoft Entra External ID, ADR-014). Find them in the Entra admin center.
# The SPA app registration's application (client) ID
VITE_ENTRA_CLIENT_ID=<spa-client-id>
# The tenant's sign-in address, ending in a slash
VITE_ENTRA_AUTHORITY=https://<tenant-subdomain>.ciamlogin.com/
# The API's scope in full: api://<api-client-id>/<scope-name> (the API's own ENTRA_API_SCOPE is the bare scope name)
VITE_ENTRA_API_SCOPE=api://<api-client-id>/<scope-name>

# Dev only, in .env.development.local: a token printed by `npm run dev:auth` in NODEAPI. With it set, `npm run dev`
# signs in without Microsoft (the Sign in button just starts a dev session). A production build ignores it.
# VITE_DEV_AUTH_TOKEN=
